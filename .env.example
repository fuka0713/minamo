DB_USER=app
DB_PASSWORD=change-me
DB_NAME=wishlist
S3_ACCESS_KEY=app
S3_SECRET_KEY=change-me
# お店の情報：dummy（仮のお店・既定）/ overpass（OpenStreetMap で調べる。キー不要・位置は約100mに丸めて送る）/ none
POI_PROVIDER=dummy
# 生成 AI の鍵（解析・推薦日・推薦理由に使う）。どちらか1つでよい。空ならルールで動く。本物の鍵はサーバーの .env だけに書く
#   Gemini：Google AI Studio（https://aistudio.google.com/apikey）で発行
#   Groq  ：GroqCloud（https://console.groq.com/keys）で発行
GEMINI_API_KEY=
GROQ_API_KEY=
# 両方入れたときに使う方（gemini / groq）
LLM_PROVIDER=
