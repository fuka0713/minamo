# このファイルをコピーして .env を作り、値を書きかえる（.env は Git に入れない）
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=wishlist
S3_ACCESS_KEY=app
S3_SECRET_KEY=change-me

