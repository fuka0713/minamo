DB_USER=app
DB_PASSWORD=change-me
DB_NAME=wishlist
S3_ACCESS_KEY=app
S3_SECRET_KEY=change-me
# お店の情報：dummy（仮のお店・既定）/ overpass（OpenStreetMap で調べる。キー不要・位置は約100mに丸めて送る）/ none
POI_PROVIDER=dummy
# 生成 AI（解析・推薦日・推薦理由に使う）。使う方：gemini（既定）/ xai
LLM_PROVIDER=gemini
# 鍵はどちらか1つでよい（選んだ方の鍵が無ければ、もう一方を使う）。両方空ならルールで動く。本物の鍵はサーバーの .env だけに書く
#   Gemini   ：Google AI Studio（https://aistudio.google.com/apikey）で発行。無料枠あり
#   xAI Grok ：xAI Console（https://console.x.ai）で発行。クレジットを先に買う（有料）
GEMINI_API_KEY=
XAI_API_KEY=
# Gemini の呼び先（ふつうは空でよい）。空なら Gemini API（AI Studio の鍵）を先に試し、だめなら Vertex AI も試す
# GEMINI_ENDPOINT=gemini / vertex
